# =====================================================================
# Doxygen configuration for the Group 23 Numerical Computing 2 library.
# Run from the repository root:   Doxyfile
# Open the result:                documentation/api/html/index.html
# =====================================================================
PROJECT_NAME           = "Group 23 Numerical Computing 2"
PROJECT_BRIEF          = "A C++17 library for root finding, interpolation, integration, ODEs and linear systems"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = documentation/api
CREATE_SUBDIRS         = NO

# ---- What to read ----------------------------------------------------
INPUT                  = include src tests examples documentation/modules documentation/README.md documentation/algorithm-report.md documentation/testing.md documentation/example results documentation/tests results
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */build-gpp/*
USE_MDFILE_AS_MAINPAGE = documentation/README.md
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

# ---- What to extract ------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
SORT_MEMBER_DOCS       = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# ---- Warnings: every public item must be documented -----------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

# ---- Output ---------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
CLASS_GRAPH            = YES
